# Exemplo com valores fictícios. Copie para .env (ignorado pelo Git) e ajuste localmente.
# Nunca versionar credenciais reais.
PORT=3000
# A API conecta com o usuário de execução (membro de finbank_runtime, sem posse de objetos).
DATABASE_URL=postgresql://finbank_app:troque-esta-senha-de-execucao@localhost:5432/finbank_v2_dev
# Migrações e provisionamento usam o dono do esquema; informe a URL dele só ao rodar esses comandos:
#   DATABASE_URL=postgresql://finbank_dev:troque-esta-senha@localhost:5432/finbank_v2_dev npm run prisma:migrate:deploy
#   DATABASE_URL=<url do dono> RUNTIME_DB_USER=finbank_app RUNTIME_DB_PASSWORD=<senha> node scripts/provision-runtime-role.mjs
# Opcionais: prazos da sessão em minutos (1 a 1440; inatividade menor ou igual ao total).
# SESSION_IDLE_MINUTES=30
# SESSION_ABSOLUTE_MINUTES=480
# Desenvolvimento sem HTTPS: cookies sem Secure, só para localhost/127.0.0.1/[::1]. Padrão: secure.
COOKIE_TRANSPORT=local-http
# Opcionais: limite de tentativas de login.
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_WINDOW_MINUTES=15
# LOGIN_RESTRICTION_SECONDS=30
# LOGIN_MAX_RESTRICTION_SECONDS=900
