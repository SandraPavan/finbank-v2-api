{
  "name": "finbank-v2-api",
  "version": "0.0.0",
  "private": true,
  "description": "FinBank V2 — API NestJS (monólito modular)",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "test": "vitest run --project unit",
    "test:integration": "prisma generate && vitest run --project integration"
  },
  "dependencies": {
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.2",
    "@nestjs/platform-express": "12.4.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "12.4.2",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "24.19.2",
    "prisma": "7.10.1",
    "testcontainers": "12.2.1",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
