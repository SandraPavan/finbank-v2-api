{
  "name": "finbank-v2-api",
  "version": "0.0.0",
  "private": true,
  "description": "FinBank V2 — API NestJS (monólito modular)",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "lint": "prisma generate && eslint . --max-warnings 0",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "admin": "node dist/admin.js",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "test": "vitest run --project unit",
    "test:integration": "prisma generate && vitest run --project integration",
    "test:contract": "prisma generate && env PACT_DO_NOT_TRACK=true SCARF_ANALYTICS=false vitest run --project contract",
    "verify": "npm run audit:prod && npm run lint && npm run typecheck && npm test && npm run build",
    "audit:prod": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@nestjs/common": "12.4.2",
    "@nestjs/core": "12.4.2",
    "@nestjs/platform-express": "12.4.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "12.4.2",
    "@pact-foundation/pact": "17.1.4",
    "@testcontainers/postgresql": "12.2.1",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "pactum": "3.9.1",
    "prisma": "7.10.1",
    "testcontainers": "12.2.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "4.1.12"
  },
  "overrides": {
    "@prisma/config": {
      "effect": "3.22.4"
    },
    "archiver-utils": {
      "glob": {
        ".": "14.0.6",
        "minimatch": "11.0.8"
      }
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.8"
    }
  }
}
