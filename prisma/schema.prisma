// Persistência da API. DEV-003: fundação sem modelos.
// DEV-010: núcleo de execução financeira (contas técnicas, operações e ledger).
// DEV-014 e DEV-015: identidades, vínculos com workspaces, e-mail de login e alias.
// DEV-016: credencial permanente e sessões.
// DEV-019: auditoria administrativa.
// DEV-020: credencial temporária e escopo da sessão.
// DEV-023: configuração educacional em revisões.
// DEV-024: estados de workspace e conta, crédito educacional e modalidade.
// DEV-025: relógio simulado em revisões.
// DEV-026: modalidade do workspace e código de inscrição em revisões.
// Restrições que o Prisma não expressa (CHECKs, índice parcial, imutabilidade e
// equilíbrio) estão na migração SQL correspondente.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum AccountKind {
  STANDARD
  CONTRA

  @@map("account_kind")
}

enum OperationType {
  TRANSFER
  REVERSAL
  EDUCATIONAL_CREDIT

  @@map("operation_type")
}

enum IdentityStatus {
  ACTIVE
  DISABLED

  @@map("identity_status")
}

enum MembershipRole {
  CUSTOMER
  FACILITATOR

  @@map("membership_role")
}

enum MembershipStatus {
  ACTIVE
  REVOKED

  @@map("membership_status")
}

enum AuditActorType {
  OPERATOR
  IDENTITY

  @@map("audit_actor_type")
}

enum AuditResult {
  CHANGED
  UNCHANGED

  @@map("audit_result")
}

enum SessionScope {
  NORMAL
  PASSWORD_CHANGE

  @@map("session_scope")
}

enum WorkspaceStatus {
  ACTIVE
  ARCHIVED

  @@map("workspace_status")
}

enum AccountStatus {
  ACTIVE
  BLOCKED

  @@map("account_status")
}

enum WorkspaceModality {
  SHARED
  ISOLATED

  @@map("workspace_modality")
}

enum PaymentModality {
  PIX_KEY
  PIX_COPY_PASTE
  PIX_QR_STATIC

  @@map("payment_modality")
}

/// Escopo de dados. Não representa identidade nem autorização.
model Workspace {
  id          String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt   DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)
  accounts    Account[]
  operations  PaymentOperation[]
  entries     LedgerEntry[]
  alias       String?                     @unique @db.VarChar(40)
  status      WorkspaceStatus             @default(ACTIVE)
  memberships WorkspaceMembership[]
  customers   UserIdentity[]
  audit       AuditRecord[]
  educational EducationalConfigRevision[]
  clock       SimulationClockRevision[]
  modality    WorkspaceModality           @default(ISOLATED)
  enrollment  WorkspaceEnrollmentCode[]

  @@map("workspace")
}

/// Conta técnica com saldo materializado. Alterada somente pelo módulo payment-execution.
model Account {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String             @map("workspace_id") @db.Uuid
  kind         AccountKind
  balanceCents BigInt             @default(0) @map("balance_cents")
  status       AccountStatus      @default(ACTIVE)
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  workspace    Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  debits       PaymentOperation[] @relation("debit")
  credits      PaymentOperation[] @relation("credit")
  entries      LedgerEntry[]

  @@unique([workspaceId, id])
  @@map("account")
}

/// Operação executada (imutável). Chave de idempotência única por workspace.
/// REVERSAL é o estorno total de uma TRANSFER do mesmo workspace (no máximo um por operação).
model PaymentOperation {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId         String            @map("workspace_id") @db.Uuid
  operationKey        String            @map("operation_key") @db.VarChar(128)
  fingerprint         String            @db.Char(64)
  type                OperationType     @default(TRANSFER)
  reversesOperationId String?           @map("reverses_operation_id") @db.Uuid
  modality            PaymentModality?
  debitAccountId      String            @map("debit_account_id") @db.Uuid
  creditAccountId     String            @map("credit_account_id") @db.Uuid
  amountCents         BigInt            @map("amount_cents")
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  workspace           Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  debitAccount        Account           @relation("debit", fields: [workspaceId, debitAccountId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  creditAccount       Account           @relation("credit", fields: [workspaceId, creditAccountId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  entries             LedgerEntry[]
  reverses            PaymentOperation? @relation("reversal", fields: [workspaceId, reversesOperationId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  reversedBy          PaymentOperation? @relation("reversal")

  @@unique([workspaceId, operationKey])
  @@unique([workspaceId, id])
  @@unique([workspaceId, reversesOperationId])
  @@map("payment_operation")
}

/// Lançamento de dupla entrada (imutável). Débito negativo, crédito positivo.
model LedgerEntry {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String           @map("workspace_id") @db.Uuid
  operationId String           @map("operation_id") @db.Uuid
  accountId   String           @map("account_id") @db.Uuid
  amountCents BigInt           @map("amount_cents")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  operation   PaymentOperation @relation(fields: [workspaceId, operationId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)
  account     Account          @relation(fields: [workspaceId, accountId], references: [workspaceId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([operationId, accountId])
  @@index([workspaceId, accountId])
  @@map("ledger_entry")
}

/// Identidade que acessa workspaces. CUSTOMER pertence a um único workspace; FACILITATOR é global.
/// E-mail sempre normalizado; unicidade por perfil em índices parciais da migração.
model UserIdentity {
  id          String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  status      IdentityStatus
  profile     MembershipRole
  email       String                @db.VarChar(254)
  workspaceId String?               @map("workspace_id") @db.Uuid
  workspace   Workspace?            @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  memberships WorkspaceMembership[]

  credential           PasswordCredential?
  temporary            TemporaryCredential[]
  sessions             UserSession[]
  audit                AuditRecord[]
  educationalRevisions EducationalConfigRevision[]
  clockRevisions       SimulationClockRevision[]
  enrollmentCodes      WorkspaceEnrollmentCode[]

  @@unique([id, profile])
  @@map("user_identity")
}

/// Vínculo administrativo, único por workspace e identidade. Somente FACILITATOR (CHECK na migração).
model WorkspaceMembership {
  workspaceId String           @map("workspace_id") @db.Uuid
  identityId  String           @map("identity_id") @db.Uuid
  role        MembershipRole
  status      MembershipStatus
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  identity    UserIdentity     @relation(fields: [identityId, role], references: [id, profile], onDelete: Restrict, onUpdate: Restrict)

  @@id([workspaceId, identityId])
  @@index([identityId])
  @@map("workspace_membership")
}

/// Credencial permanente (Argon2id). Criada fora da execução, que só a atualiza.
model PasswordCredential {
  identityId    String       @id @map("identity_id") @db.Uuid
  hash          String       @db.VarChar(160)
  updatedAt     DateTime     @default(now()) @map("updated_at") @db.Timestamptz(3)
  /// Preenchido na recuperação: a senha gravada deixa de autenticar.
  invalidatedAt DateTime?    @map("invalidated_at") @db.Timestamptz(3)
  identity      UserIdentity @relation(fields: [identityId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@map("password_credential")
}

/// Sessão. Guarda só o SHA-256 do segredo; estado derivado dos prazos e do encerramento.
model UserSession {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identityId        String       @map("identity_id") @db.Uuid
  tokenHash         String       @unique @map("token_hash") @db.Char(64)
  createdAt         DateTime     @map("created_at") @db.Timestamptz(3)
  lastActivityAt    DateTime     @map("last_activity_at") @db.Timestamptz(3)
  idleExpiresAt     DateTime     @map("idle_expires_at") @db.Timestamptz(3)
  absoluteExpiresAt DateTime     @map("absolute_expires_at") @db.Timestamptz(3)
  revokedAt         DateTime?    @map("revoked_at") @db.Timestamptz(3)
  scope             SessionScope
  identity          UserIdentity @relation(fields: [identityId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([identityId])
  @@map("user_session")
}

/// Contador de tentativas por assunto (SHA-256). Linhas vencidas são removidas pela execução.
model AuthenticationControl {
  subjectHash     String    @id @map("subject_hash") @db.Char(64)
  failures        Int
  windowStartedAt DateTime  @map("window_started_at") @db.Timestamptz(3)
  restrictedUntil DateTime? @map("restricted_until") @db.Timestamptz(3)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("authentication_control")
}

/// Operação administrativa (só inserção). Sem senha, e-mail ou segredo; o operador não tem identidade.
model AuditRecord {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  occurredAt      DateTime        @default(dbgenerated("clock_timestamp()")) @map("occurred_at") @db.Timestamptz(3)
  actorType       AuditActorType  @map("actor_type")
  actorIdentityId String?         @map("actor_identity_id") @db.Uuid
  actorProfile    MembershipRole? @map("actor_profile")
  workspaceId     String?         @map("workspace_id") @db.Uuid
  operation       String          @db.VarChar(40)
  resourceType    String          @map("resource_type") @db.VarChar(40)
  resourceId      String          @map("resource_id") @db.Uuid
  result          AuditResult
  correlationId   String          @map("correlation_id") @db.VarChar(64)
  actor           UserIdentity?   @relation(fields: [actorIdentityId, actorProfile], references: [id, profile], onDelete: Restrict, onUpdate: Restrict)
  workspace       Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([workspaceId, occurredAt])
  @@map("audit_record")
}

/// Credencial de recuperação, de uso único. Estado derivado do prazo, do uso e da revogação.
model TemporaryCredential {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identityId String       @map("identity_id") @db.Uuid
  hash       String       @db.VarChar(160)
  issuedAt   DateTime     @default(dbgenerated("clock_timestamp()")) @map("issued_at") @db.Timestamptz(3)
  expiresAt  DateTime     @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?    @map("consumed_at") @db.Timestamptz(3)
  revokedAt  DateTime?    @map("revoked_at") @db.Timestamptz(3)
  identity   UserIdentity @relation(fields: [identityId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([identityId])
  @@map("temporary_credential")
}

enum EducationalMode {
  STUDENT
  CONTROLLED

  @@map("educational_mode")
}

enum EducationalPreset {
  NONE
  ALL
  LAB

  @@map("educational_preset")
}

/// Revisão da configuração educacional (só inserção). A vigente é a de maior número; 0 = padrão, nunca gravado.
model EducationalConfigRevision {
  id               String             @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId      String             @map("workspace_id") @db.Uuid
  revision         Int
  catalogVersion   String             @map("catalog_version") @db.VarChar(12)
  mode             EducationalMode
  preset           EducationalPreset?
  labCodeHash      String?            @map("lab_code_hash") @db.Char(64)
  enabledDefectIds String[]           @map("enabled_defect_ids")
  createdBy        String             @map("created_by") @db.Uuid
  createdAt        DateTime           @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(3)
  workspace        Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  author           UserIdentity       @relation(fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([workspaceId, revision])
  @@map("educational_config_revision")
}

/// Revisão do relógio simulado (só inserção). A vigente é a de maior número; 0 = data de criação do workspace, nunca gravada.
model SimulationClockRevision {
  id           String       @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String       @map("workspace_id") @db.Uuid
  revision     Int
  businessDate DateTime     @map("business_date") @db.Date
  createdBy    String       @map("created_by") @db.Uuid
  createdAt    DateTime     @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(3)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  author       UserIdentity @relation(fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([workspaceId, revision])
  @@map("simulation_clock_revision")
}

/// Revisão do código de inscrição (só inserção). A vigente é a de maior número; sem hash, o código foi revogado. O código em claro nunca é gravado.
model WorkspaceEnrollmentCode {
  id          String       @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId String       @map("workspace_id") @db.Uuid
  revision    Int
  codeHash    String?      @map("code_hash") @db.Char(64)
  createdBy   String       @map("created_by") @db.Uuid
  createdAt   DateTime     @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(3)
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  author      UserIdentity @relation(fields: [createdBy], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([workspaceId, revision])
  @@map("workspace_enrollment_code")
}
